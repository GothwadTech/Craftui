// =========================================================================
// CRAFTUI CLEAN-ROOM REUSABLE COMPONENTS (MIT / Apache-2.0)
// Architectural design inspired by Slint's component & token model
// =========================================================================

component ActionToolButton {
    in property <string> label: "";
    in property <string> icon: "camera";
    in property <string> badge_text: "";
    in property <color> icon_bg: #0E3B43;
    in property <color> icon_fg: #00BCD4;
    callback on_tap();

    Column {
        align: Center;
        gap: 6dp;

        Button {
            background: icon_bg;
            foreground: icon_fg;
            border_radius: 28dp;
            width: 56dp;
            height: 56dp;
            align: Center;
            justify: Center;
            on_tap => {
                on_tap();
            }
            if badge_text != "" : Text {
                text: badge_text;
                font_size: 18;
                font_weight: 700;
                color: icon_fg;
            }
            if badge_text == "" : Icon {
                svg: icon;
                size: 24;
                color: icon_fg;
            }
        }

        Text {
            text: label;
            font_size: 11;
            font_weight: 600;
            color: #E2E8F0;
        }
    }
}

component DocCardCode {
    in property <string> title: "New Doc 11-09-2026 21.45";
    in property <string> date: "09/11/26 21:46";
    in property <string> pages: "3";
    callback on_tap();
    callback on_more();

    Row {
        width: 100%;
        background: #00000000;
        gap: 14dp;
        align: Center;
        on_tap => {
            on_tap();
        }

        // Thumbnail with Badge
        Column {
            width: 66dp;
            height: 86dp;
            border_radius: 8dp;
            background: #0D1525;
            border_width: 1.0;
            border_color: #1E293B;
            padding: 6dp;
            justify: SpaceBetween;

            Column {
                gap: 3dp;
                Row { width: 100%; height: 4dp; background: #38BDF8; border_radius: 2dp; }
                Row { width: 80%; height: 3dp; background: #34D399; border_radius: 2dp; }
                Row { width: 90%; height: 3dp; background: #FBBF24; border_radius: 2dp; }
                Row { width: 70%; height: 3dp; background: #A78BFA; border_radius: 2dp; }
                Row { width: 50%; height: 3dp; background: #64748B; border_radius: 2dp; }
            }

            Row {
                width: 100%;
                justify: End;
                Badge { label: "✓"; background: #00897B; color: #FFFFFF; }
            }
        }

        // Info Column
        Column {
            flex_grow: 1.0;
            gap: 4dp;

            Text {
                text: title;
                font_size: 16;
                font_weight: 600;
                color: #FFFFFF;
            }

            Text {
                text: date;
                font_size: 13;
                color: #8E95A5;
            }

            Row {
                gap: 4dp;
                align: Center;
                Icon {
                    svg: "pages";
                    size: 13;
                    color: #8E95A5;
                }
                Text { text: pages; font_size: 13; color: #8E95A5; }
            }
        }

        Button {
            background: #00000000;
            width: 32dp;
            height: 32dp;
            align: Center;
            justify: Center;
            on_tap => {
                on_more();
            }
            Icon {
                svg: "more_vert";
                size: 20;
                color: #8E95A5;
            }
        }
    }
}

