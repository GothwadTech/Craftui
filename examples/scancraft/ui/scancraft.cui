            }
        }

        Button {
            background: #00000000;
            width: 32dp;
            height: 32dp;
            align: Center;
            justify: Center;
            on_tap => {
                on_more();
            }
            Icon {
                svg: "more_vert";
                size: 20;
                color: #8E95A5;
            }
        }
    }
}

