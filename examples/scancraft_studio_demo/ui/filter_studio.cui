import { Column, Row, Button, Slider, ImageView, ScrollView, Text } from "std/widgets.cui"
import { Theme } from "theme/tokens.cui"

export component FilterStudioTemplate {
    in property <TextureHandle> preview_texture;
    in-out property <int> selected_filter: 0;
    in-out property <float> brightness: 0.0;
    in-out property <float> contrast: 0.0;

    callback on_filter_changed(int);
    callback on_apply_clicked();

    Column {
        width: 100%;
        height: 100%;
        background: Theme.background;
        padding: SafeArea.insets;

        ImageView {
            flex_grow: 1.0;
            source: preview_texture;
            fit: Contain;
            border_radius: 12dp;
            margin: 16dp;
        }

        Column {
            gap: 8dp;
            padding_x: 16dp;

            Slider {
                label: "Brightness";
                value <=> brightness;
                min: -100.0;
                max: 100.0;
            }
            Slider {
                label: "Contrast";
                value <=> contrast;
                min: -100.0;
                max: 100.0;
            }
        }

        ScrollView {
            direction: Horizontal;
            height: 88dp;
            Row {
                gap: 10dp;
                padding_x: 16dp;
                for item, idx in ["Original", "Magic Color", "B&W", "No Shadow", "Warm"] : Button {
                    text: item;
                    on_tap => {
                        selected_filter = idx;
                        on_filter_changed(idx);
                    }
                }
            }
        }

        Row {
            padding: 16dp;
            justify: End;
            Button {
                text: "Save Scan";
                background: Theme.primary;
                foreground: #FFFFFF;
                border_radius: 24dp;
                on_tap => { on_apply_clicked(); }
            }
        }
    }
}
