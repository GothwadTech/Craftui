export component ScanCraftApp {
    in-out property <int> active_tab: 0;
    in-out property <string> doc_title: "Contract_Agreement_v2.pdf";
    in-out property <int> scan_preset: 0;
    in-out property <int> filter_mode: 2;
    in-out property <float> brightness: 0.0;
    in-out property <float> contrast: 1.2;
    in-out property <int> rotation_deg: 0;
    in-out property <string> search_query: "";
    in-out property <int> selected_doc_index: 0;
    in-out property <string> status_message: "ScanApp Ready — AI Document Scanner Active";
    in-out property <string> battery_status: "94% Battery";
    in-out property <string> storage_status: "52.4 GB Free";
    in-out property <string> camera_perm_badge: "Camera: Granted";
    in-out property <int> export_format: 0;
    in-out property <bool> is_processing: false;
    in-out property <bool> search_open: false;
    in-out property <bool> ocr_modal_open: false;
    in-out property <bool> pdf_modal_open: false;
    in-out property <string> ocr_text: "TAX INVOICE\nDate: 11-09-2026\nItem: Antigravity AI Engine\nAmount: $0.00\nStatus: VERIFIED_PAID";
    in-out property <bool> capture_btn_hovered: false;
    in-out property <bool> gallery_btn_hovered: false;
    in-out property <bool> share_btn_hovered: false;
    in-out property <bool> save_btn_hovered: false;
    in-out property <bool> accordion_open: true;

    in property <[[string]]> doc_table_rows: [
        ["DOC-001", "Contract_Agreement_v2.pdf", "Legal", "09/11/26 21:46", "3 Pages", "Indexed"],
        ["DOC-002", "New Doc 11-09-2026 15.11", "Finance", "09/11/26 15:13", "9 Pages", "Ready"],
        ["DOC-003", "New Doc 11-09-2026 13.00", "Health", "09/11/26 13:00", "3 Pages", "Ready"],
        ["DOC-004", "Equipment_Warranty.pdf", "Personal", "2026-11-11", "1.2 MB", "Synced"],
        ["DOC-005", "Whiteboard_Brainstorm.jpeg", "Work", "2026-11-11", "3.6 MB", "Draft"]
    ];

    callback on_capture_photo();
    callback on_import_gallery();
    callback on_apply_filter(int);
    callback on_rotate();
    callback on_save_doc();
    callback on_delete_doc();
    callback on_share_doc();
    callback on_theme_toggle();
    callback on_request_permissions();

    SafeArea {
        Column {
            width: 100%;
            height: 100%;
            background: #000000;
            padding: 12dp;
            gap: 12dp;

            // =========================================================================
            // VIEW 0: MAIN SCREEN (Matches User Screenshot 100% Exactly)
            // =========================================================================
            if active_tab == 0 : Column {
                flex_grow: 1.0;
                width: 100%;
                gap: 12dp;

                // --- Top Header Bar ---
                Row {
                    width: 100%;
                    justify: SpaceBetween;
                    align: Center;

                    // User Profile Avatar
                    Button {
                        id: "profile_avatar_btn";
                        background: #0E2938;
                        border_radius: 20dp;
                        width: 40dp;
                        height: 40dp;
                        align: Center;
                        justify: Center;
                        on_tap => {
                            status_message = "Profile & Settings opened";
                        }
                        Icon {
                            svg: "user";
                            size: 20;
                            color: #00BCD4;
                        }
                    }

                    // App Title & Aperture Logo
                    Row {
                        gap: 8dp;
                        align: Center;

                        Icon {
                            svg: "aperture";
                            size: 24;
                            color: #00BCD4;
                        }

                        Text {
                            text: "ScanApp";
                            font_size: 22;
                            font_weight: 800;
                            color: #00BCD4;
                        }
                    }

                    // Right Actions (Theme Toggle & Search Toggle)
                    Row {
                        gap: 8dp;
                        align: Center;

                        Button {
                            id: "theme_toggle_btn";
                            background: #00000000;
                            border_radius: 18dp;
                            width: 36dp;
                            height: 36dp;
                            align: Center;
                            justify: Center;
                            on_tap => {
                                on_theme_toggle();
                            }
                            Icon {
                                svg: "sun";
                                size: 20;
                                color: #FACC15;
                            }
                        }

                        Button {
                            id: "search_toggle_btn";
                            background: #00000000;
                            border_radius: 18dp;
                            width: 36dp;
                            height: 36dp;
                            align: Center;
                            justify: Center;
                            on_tap => {
                                search_open = !search_open;
                            }
                            Icon {
                                svg: "search";
                                size: 20;
                                color: #FFFFFF;
                            }
                        }
                    }
                }

                // --- Optional Live Search Bar ---
                if search_open : Row {
                    width: 100%;
                    background: #1E293B;
                    border_radius: 12dp;
                    padding: 8dp;
                    gap: 8dp;
                    align: Center;

                    Icon {
                        svg: "search";
                        size: 16;
                        color: #94A3B8;
                    }

                    TextInput {
                        id: "search_input_box";
                        placeholder: "Search documents by name...";
                        value <=> search_query;
                        flex_grow: 1.0;
                    }
                }

                // --- 8-Tool Action Grid (2 Rows x 4 Columns) ---
                Column {
                    width: 100%;
                    gap: 14dp;
                    padding_y: 4dp;

                    // Row 1 (Smart Scan, Import Photos, Import Files, ID Card)
                    Row {
                        width: 100%;
                        justify: SpaceAround;
                        align: Center;

                        Column {
                            align: Center;
                            gap: 6dp;

                            Button {
                                id: "grid_smart_scan";
                                background: #0E3B43;
                                border_radius: 28dp;
                                width: 56dp;
                                height: 56dp;
                                align: Center;
                                justify: Center;
                                on_tap => {
                                    on_capture_photo();
                                }
                                Icon {
                                    svg: "camera";
                                    size: 24;
                                    color: #00BCD4;
                                }
                            }

                            Text {
                                text: "Smart Scan";
                                font_size: 11;
                                font_weight: 600;
                                color: #E2E8F0;
                            }
                        }

                        Column {
                            align: Center;
                            gap: 6dp;

                            Button {
                                id: "grid_import_photos";
                                background: #1E3A68;
                                border_radius: 28dp;
                                width: 56dp;
                                height: 56dp;
                                align: Center;
                                justify: Center;
                                on_tap => {
                                    on_import_gallery();
                                }
                                Icon {
                                    svg: "image";
                                    size: 24;
                                    color: #38BDF8;
                                }
                            }

                            Text {
                                text: "Import Photos";
                                font_size: 11;
                                font_weight: 600;
                                color: #E2E8F0;
                            }
                        }

                        Column {
                            align: Center;
                            gap: 6dp;

                            Button {
                                id: "grid_import_files";
                                background: #452A14;
                                border_radius: 28dp;
                                width: 56dp;
                                height: 56dp;
                                align: Center;
                                justify: Center;
                                on_tap => {
                                    on_import_gallery();
                                }
                                Icon {
                                    svg: "upload";
                                    size: 24;
                                    color: #FB923C;
                                }
                            }

                            Text {
                                text: "Import Files";
                                font_size: 11;
                                font_weight: 600;
                                color: #E2E8F0;
                            }
                        }

                        Column {
                            align: Center;
                            gap: 6dp;

                            Button {
                                id: "grid_id_card";
                                background: #0C3C47;
                                border_radius: 28dp;
                                width: 56dp;
                                height: 56dp;
                                align: Center;
                                justify: Center;
                                on_tap => {
                                    on_capture_photo();
                                }
                                Icon {
                                    svg: "badge_id";
                                    size: 24;
                                    color: #00BCD4;
                                }
                            }

                            Text {
                                text: "ID Card";
                                font_size: 11;
                                font_weight: 600;
                                color: #E2E8F0;
                            }
                        }
                    }

                    // Row 2 (To Text (OCR), PDF Tools, Watermark, All Tools)
                    Row {
                        width: 100%;
                        justify: SpaceAround;
                        align: Center;

                        Column {
                            align: Center;
                            gap: 6dp;

                            Button {
                                id: "grid_ocr";
                                text: "TT";
                                background: #3B1A59;
                                foreground: #B388FF;
                                font_size: 18;
                                font_weight: 700;
                                border_radius: 28dp;
                                width: 56dp;
                                height: 56dp;
                                on_tap => {
                                    active_tab = 2;
                                }
                            }

                            Text {
                                text: "To Text (OCR)";
                                font_size: 11;
                                font_weight: 600;
                                color: #E2E8F0;
                            }
                        }

                        Column {
                            align: Center;
                            gap: 6dp;

                            Button {
                                id: "grid_pdf_tools";
                                background: #4A151B;
                                border_radius: 28dp;
                                width: 56dp;
                                height: 56dp;
                                align: Center;
                                justify: Center;
                                on_tap => {
                                    active_tab = 5;
                                }
                                Icon {
                                    svg: "pdf";
                                    size: 22;
                                    color: #EF4444;
                                }
                            }

                            Text {
                                text: "PDF Tools";
                                font_size: 11;
                                font_weight: 600;
                                color: #E2E8F0;
                            }
                        }

                        Column {
                            align: Center;
                            gap: 6dp;

                            Button {
                                id: "grid_watermark";
                                background: #0E3D38;
                                border_radius: 28dp;
                                width: 56dp;
                                height: 56dp;
                                align: Center;
                                justify: Center;
                                on_tap => {
                                    active_tab = 1;
                                }
                                Icon {
                                    svg: "watermark";
                                    size: 24;
                                    color: #10B981;
                                }
                            }

                            Text {
                                text: "Watermark";
                                font_size: 11;
                                font_weight: 600;
                                color: #E2E8F0;
                            }
                        }

                        Column {
                            align: Center;
                            gap: 6dp;

                            Button {
                                id: "grid_all_tools";
                                background: #2A303A;
                                border_radius: 28dp;
                                width: 56dp;
                                height: 56dp;
                                align: Center;
                                justify: Center;
                                on_tap => {
                                    active_tab = 2;
                                }
                                Icon {
                                    svg: "grid_3x3";
                                    size: 22;
                                    color: #8E95A5;
                                }
                            }

                            Text {
                                text: "All Tools";
                                font_size: 11;
                                font_weight: 600;
                                color: #E2E8F0;
                            }
                        }
                    }
                }

                // --- Engine Mode Switcher Bar ---
                Row {
                    width: 100%;
                    gap: 6dp;
                    align: Center;

                    Button {
                        text: "📱 AMOLED Native";
                        background: active_tab == 0 ? #0E3B43 : #18222F;
                        foreground: active_tab == 0 ? #00BCD4 : #94A3B8;
                        border_radius: 12dp;
                        padding_x: 8dp;
                        padding_y: 5dp;
                        font_size: 11;
                        font_weight: 600;
                        on_tap => { active_tab = 0; }
                    }

                    Button {
                        text: "⚡ HTML (Rust)";
                        background: active_tab == 3 ? #0E3B43 : #18222F;
                        foreground: active_tab == 3 ? #00BCD4 : #94A3B8;
                        border_radius: 12dp;
                        padding_x: 8dp;
                        padding_y: 5dp;
                        font_size: 11;
                        font_weight: 600;
                        on_tap => { active_tab = 3; }
                    }

                    Button {
                        text: "🌐 Tauri 2.0";
                        background: active_tab == 4 ? #0E3B43 : #18222F;
                        foreground: active_tab == 4 ? #00BCD4 : #94A3B8;
                        border_radius: 12dp;
                        padding_x: 8dp;
                        padding_y: 5dp;
                        font_size: 11;
                        font_weight: 600;
                        on_tap => { active_tab = 4; }
                    }
                }

                // --- Recent Docs Section Header ---
                Row {
                    width: 100%;
                    justify: SpaceBetween;
                    align: Center;
                    padding_y: 6dp;

                    Column {
                        gap: 2dp;

                        Text {
                            text: "Recent Docs";
                            font_size: 20;
                            font_weight: 800;
                            color: #FFFFFF;
                        }

                        Text {
                            text: "All docs (3) ▼";
                            font_size: 12;
                            color: #8E95A5;
                        }
                    }

                    Row {
                        gap: 12dp;
                        align: Center;

                        Button {
                            id: "action_folder";
                            background: #00000000;
                            width: 24dp;
                            height: 24dp;
                            align: Center;
                            justify: Center;
                            on_tap => {
                                status_message = "New Folder Dialog";
                            }
                            Icon {
                                svg: "folder_plus";
                                size: 18;
                                color: #8E95A5;
                            }
                        }

                        Button {
                            id: "action_sort";
                            background: #00000000;
                            width: 24dp;
                            height: 24dp;
                            align: Center;
                            justify: Center;
                            on_tap => {
                                status_message = "Sorted by newest first";
                            }
                            Icon {
                                svg: "sort";
                                size: 18;
                                color: #8E95A5;
                            }
                        }

                        Button {
                            id: "action_view_mode";
                            background: #00000000;
                            width: 24dp;
                            height: 24dp;
                            align: Center;
                            justify: Center;
                            on_tap => {
                                status_message = "Toggled view mode";
                            }
                            Icon {
                                svg: "grid";
                                size: 18;
                                color: #8E95A5;
                            }
                        }

                        Button {
                            id: "action_multi_select";
                            background: #00000000;
                            width: 24dp;
                            height: 24dp;
                            align: Center;
                            justify: Center;
                            on_tap => {
                                status_message = "Batch selection mode";
                            }
                            Icon {
                                svg: "check_double";
                                size: 18;
                                color: #8E95A5;
                            }
                        }
                    }
                }

                // --- Recent Docs Scrollable Card List (Clean Black Background, No Bulky Boxes) ---
                ScrollView {
                    width: 100%;
                    flex_grow: 1.0;

                    Column {
                        width: 100%;
                        gap: 16dp;
                        padding_y: 6dp;

                        // Item 1: Code Screen Document
                        Row {
                            width: 100%;
                            background: #00000000;
                            gap: 14dp;
                            align: Center;

                            // Thumbnail with Badge
                            Column {
                                width: 66dp;
                                height: 86dp;
                                border_radius: 8dp;
                                background: #0D1525;
                                border_width: 1.0;
                                border_color: #1E293B;
                                padding: 6dp;
                                justify: SpaceBetween;

                                Column {
                                    gap: 3dp;
                                    Row { width: 100%; height: 4dp; background: #38BDF8; border_radius: 2dp; }
                                    Row { width: 80%; height: 3dp; background: #34D399; border_radius: 2dp; }
                                    Row { width: 90%; height: 3dp; background: #FBBF24; border_radius: 2dp; }
                                    Row { width: 70%; height: 3dp; background: #A78BFA; border_radius: 2dp; }
                                    Row { width: 50%; height: 3dp; background: #64748B; border_radius: 2dp; }
                                }

                                Row {
                                    width: 100%;
                                    justify: End;
                                    Badge { label: "✓"; background: #00897B; color: #FFFFFF; }
                                }
                            }

                            // Info Column
                            Column {
                                flex_grow: 1.0;
                                gap: 4dp;

                                Text {
                                    text: "New Doc 11-09-2026 21.45";
                                    font_size: 16;
                                    font_weight: 600;
                                    color: #FFFFFF;
                                }

                                Text {
                                    text: "09/11/26 21:46";
                                    font_size: 13;
                                    color: #8E95A5;
                                }

                                Row {
                                    gap: 4dp;
                                    align: Center;
                                    Icon {
                                        svg: "pages";
                                        size: 13;
                                        color: #8E95A5;
                                    }
                                    Text { text: "3"; font_size: 13; color: #8E95A5; }
                                }
                            }

                            Button {
                                id: "doc_opt_btn_0";
                                background: #00000000;
                                width: 32dp;
                                height: 32dp;
                                align: Center;
                                justify: Center;
                                on_tap => {
                                    on_share_doc();
                                }
                                Icon {
                                    svg: "more_vert";
                                    size: 20;
                                    color: #8E95A5;
                                }
                            }
                        }

                        // Item 2: Lined Notebook Paper with Handwriting
                        Row {
                            width: 100%;
                            background: #00000000;
                            gap: 14dp;
                            align: Center;

                            Column {
                                width: 66dp;
                                height: 86dp;
                                border_radius: 8dp;
                                background: #F8FAFC;
                                border_width: 1.0;
                                border_color: #334155;
                                padding: 6dp;
                                justify: SpaceBetween;

                                Column {
                                    gap: 4dp;
                                    Row { width: 100%; height: 2dp; background: #BFDBFE; }
                                    Row { width: 75%; height: 2.5dp; background: #334155; border_radius: 1dp; }
                                    Row { width: 100%; height: 2dp; background: #BFDBFE; }
                                    Row { width: 85%; height: 2.5dp; background: #334155; border_radius: 1dp; }
                                    Row { width: 100%; height: 2dp; background: #BFDBFE; }
                                    Row { width: 60%; height: 2.5dp; background: #334155; border_radius: 1dp; }
                                }

                                Row {
                                    width: 100%;
                                    justify: End;
                                    Badge { label: "✓"; background: #00897B; color: #FFFFFF; }
                                }
                            }

                            Column {
                                flex_grow: 1.0;
                                gap: 4dp;

                                Text {
                                    text: "New Doc 11-09-2026 15.11";
                                    font_size: 16;
                                    font_weight: 600;
                                    color: #FFFFFF;
                                }

                                Text {
                                    text: "09/11/26 15:13";
                                    font_size: 13;
                                    color: #8E95A5;
                                }

                                Row {
                                    gap: 4dp;
                                    align: Center;
                                    Icon {
                                        svg: "pages";
                                        size: 13;
                                        color: #8E95A5;
                                    }
                                    Text { text: "9"; font_size: 13; color: #8E95A5; }
                                }
                            }

                            Button {
                                id: "doc_opt_btn_1";
                                background: #00000000;
                                width: 32dp;
                                height: 32dp;
                                align: Center;
                                justify: Center;
                                on_tap => {
                                    on_share_doc();
                                }
                                Icon {
                                    svg: "more_vert";
                                    size: 20;
                                    color: #8E95A5;
                                }
                            }
                        }

                        // Item 3: Colorful Package Box
                        Row {
                            width: 100%;
                            background: #00000000;
                            gap: 14dp;
                            align: Center;

                            Column {
                                width: 66dp;
                                height: 86dp;
                                border_radius: 8dp;
                                background: #0F172A;
                                border_width: 1.0;
                                border_color: #1E293B;
                                clip: true;
                                justify: SpaceBetween;

                                Column {
                                    width: 100%;
                                    height: 40dp;
                                    background: #DC2626;
                                    align: Center;
                                    justify: Center;
                                    Text { text: "SUN"; font_size: 9; font_weight: 800; color: #FFFFFF; }
                                }

                                Row {
                                    width: 100%;
                                    height: 40dp;
                                    background: #06B6D4;
                                    align: Center;
                                    justify: SpaceBetween;
                                    padding_x: 4dp;
                                    Text { text: "LYNE"; font_size: 8; font_weight: 800; color: #000000; }
                                    Badge { label: "✓"; background: #00897B; color: #FFFFFF; }
                                }
                            }

                            Column {
                                flex_grow: 1.0;
                                gap: 4dp;

                                Text {
                                    text: "New Doc 11-09-2026 13.00";
                                    font_size: 16;
                                    font_weight: 600;
                                    color: #FFFFFF;
                                }

                                Text {
                                    text: "09/11/26 13:00";
                                    font_size: 13;
                                    color: #8E95A5;
                                }

                                Row {
                                    gap: 4dp;
                                    align: Center;
                                    Icon {
                                        svg: "pages";
                                        size: 13;
                                        color: #8E95A5;
                                    }
                                    Text { text: "3"; font_size: 13; color: #8E95A5; }
                                }
                            }

                            Button {
                                id: "doc_opt_btn_2";
                                background: #00000000;
                                width: 32dp;
                                height: 32dp;
                                align: Center;
                                justify: Center;
                                on_tap => {
                                    on_share_doc();
                                }
                                Icon {
                                    svg: "more_vert";
                                    size: 20;
                                    color: #8E95A5;
                                }
                            }
                        }
                    }
                }

                // --- Mobile Bottom Navigation Bar with Center Camera FAB ---
                Row {
                    width: 100%;
                    height: 64dp;
                    background: #000000;
                    border_width: 1.0;
                    border_color: #1E293B;
                    border_radius: 28dp;
                    align: Center;
                    justify: SpaceAround;
                    padding_x: 20dp;

                    // Documents Tab (Active)
                    Button {
                        id: "nav_tab_documents";
                        background: #00000000;
                        align: Center;
                        justify: Center;
                        on_tap => {
                            active_tab = 0;
                        }
                        Column {
                            align: Center;
                            gap: 3dp;
                            Icon {
                                svg: "document";
                                size: 20;
                                color: #00BCD4;
                            }
                            Text {
                                text: "Documents";
                                font_size: 11;
                                font_weight: 700;
                                color: #00BCD4;
                            }
                        }
                    }

                    // Center Camera FAB Button
                    Button {
                        id: "nav_camera_fab";
                        background: #00897B;
                        border_radius: 28dp;
                        width: 56dp;
                        height: 56dp;
                        align: Center;
                        justify: Center;
                        on_tap => {
                            on_capture_photo();
                        }
                        Icon {
                            svg: "camera";
                            size: 26;
                            color: #FFFFFF;
                        }
                    }

                    // Tools Tab
                    Button {
                        id: "nav_tab_tools";
                        background: #00000000;
                        align: Center;
                        justify: Center;
                        on_tap => {
                            active_tab = 1;
                        }
                        Column {
                            align: Center;
                            gap: 3dp;
                            Icon {
                                svg: "tools";
                                size: 20;
                                color: #8E95A5;
                            }
                            Text {
                                text: "Tools";
                                font_size: 11;
                                font_weight: 600;
                                color: #8E95A5;
                            }
                        }
                    }
                }
            }

            // =========================================================================
            // VIEW 1: ENHANCEMENT & FILTER STUDIO
            // =========================================================================
            if active_tab == 1 : Column {
                flex_grow: 1.0;
                width: 100%;
                gap: 12dp;

                // Studio Header
                Row {
                    width: 100%;
                    justify: SpaceBetween;
                    align: Center;

                    Button {
                        id: "back_to_docs_btn";
                        text: "← Back";
                        background: #1E293B;
                        foreground: #FFFFFF;
                        border_radius: 8dp;
                        padding: 6dp;
                        on_tap => {
                            active_tab = 0;
                        }
                    }

                    Text {
                        text: doc_title;
                        font_size: 16;
                        font_weight: 700;
                        color: #FFFFFF;
                    }

                    Button {
                        id: "save_studio_btn";
                        text: "Save";
                        background: #10B981;
                        foreground: #FFFFFF;
                        border_radius: 8dp;
                        padding: 6dp;
                        on_tap => {
                            on_save_doc();
                        }
                    }
                }

                // Document Canvas Viewport
                Column {
                    width: 100%;
                    flex_grow: 1.0;
                    min_height: 220dp;
                    background: #0B0F19;
                    border_radius: 12dp;
                    border_width: 1.5;
                    border_color: #38BDF8;
                    padding: 16dp;
                    justify: SpaceBetween;

                    Row {
                        width: 100%;
                        justify: SpaceBetween;
                        Badge { label: "120 FPS Pure-Rust Preview"; background: #0369A1; color: #FFFFFF; }
                        Text { text: "Rotation: 0°"; font_size: 12; color: #94A3B8; }
                    }

                    Column {
                        width: 100%;
                        align: Center;
                        gap: 8dp;
                        Text { text: "ScanApp Document Enhancement Studio"; font_size: 16; font_weight: 700; color: #38BDF8; }
                        Text { text: "Magic Color • High-Contrast B&W • Smart OCR"; font_size: 13; color: #94A3B8; }
                    }

                    Row {
                        width: 100%;
                        justify: SpaceBetween;
                        Text { text: "Resolution: 300 DPI"; font_size: 12; color: #64748B; }
                        Text { text: "Enhanced via CraftUI GPU"; font_size: 12; color: #10B981; }
                    }
                }

                // Filter Presets Row
                Row {
                    width: 100%;
                    gap: 8dp;
                    justify: SpaceBetween;

                    Button {
                        text: "Original";
                        background: #1E293B;
                        foreground: #E2E8F0;
                        border_radius: 8dp;
                        padding: 6dp;
                        flex_grow: 1.0;
                        on_tap => {
                            on_apply_filter(0);
                        }
                    }

                    Button {
                        text: "Magic Color";
                        background: #0369A1;
                        foreground: #FFFFFF;
                        border_radius: 8dp;
                        padding: 6dp;
                        flex_grow: 1.0;
                        on_tap => {
                            on_apply_filter(3);
                        }
                    }

                    Button {
                        text: "B&W Document";
                        background: #334155;
                        foreground: #F8FAFC;
                        border_radius: 8dp;
                        padding: 6dp;
                        flex_grow: 1.0;
                        on_tap => {
                            on_apply_filter(2);
                        }
                    }

                    Button {
                        text: "Grayscale";
                        background: #1E293B;
                        foreground: #CBD5E1;
                        border_radius: 8dp;
                        padding: 6dp;
                        flex_grow: 1.0;
                        on_tap => {
                            on_apply_filter(1);
                        }
                    }
                }

                // Adjustments (Brightness, Contrast, Rotation)
                Row {
                    width: 100%;
                    gap: 12dp;
                    align: Center;

                    Button {
                        text: "↻ Rotate 90°";
                        background: #1E293B;
                        foreground: #FFFFFF;
                        border_radius: 8dp;
                        padding: 8dp;
                        flex_grow: 1.0;
                        on_tap => {
                            on_rotate();
                        }
                    }

                    Button {
                        text: "🗑️ Delete";
                        background: #7F1D1D;
                        foreground: #FCA5A5;
                        border_radius: 8dp;
                        padding: 8dp;
                        flex_grow: 1.0;
                        on_tap => {
                            on_delete_doc();
                            active_tab = 0;
                        }
                    }

                    Button {
                        text: "📤 Share";
                        background: #0284C7;
                        foreground: #FFFFFF;
                        border_radius: 8dp;
                        padding: 8dp;
                        flex_grow: 1.0;
                        on_tap => {
                            on_share_doc();
                        }
                    }
                }
            }

            // =========================================================================
            // VIEW 2: AI TOOLS, OCR & DEVICE TELEMETRY
            // =========================================================================
            if active_tab == 2 : Column {
                flex_grow: 1.0;
                width: 100%;
                gap: 12dp;

                Row {
                    width: 100%;
                    justify: SpaceBetween;
                    align: Center;

                    Button {
                        text: "← Back";
                        background: #1E293B;
                        foreground: #FFFFFF;
                        border_radius: 8dp;
                        padding: 6dp;
                        on_tap => {
                            active_tab = 0;
                        }
                    }

                    Text {
                        text: "AI Scanner Tools";
                        font_size: 18;
                        font_weight: 700;
                        color: #FFFFFF;
                    }

                    Button {
                        text: "Done";
                        background: #10B981;
                        foreground: #FFFFFF;
                        border_radius: 8dp;
                        padding: 6dp;
                        on_tap => {
                            active_tab = 0;
                        }
                    }
                }

                // OCR Extraction Card
                Column {
                    width: 100%;
                    background: #1E293B;
                    border_radius: 12dp;
                    padding: 12dp;
                    gap: 8dp;

                    Row {
                        width: 100%;
                        justify: SpaceBetween;
                        align: Center;
                        Text { text: "AI Optical Character Recognition (OCR)"; font_size: 15; font_weight: 600; color: #FFFFFF; }
                        Badge { label: "Multi-Language"; background: #065F46; color: #6EE7B7; }
                    }

                    Text {
                        text: ocr_text;
                        font_size: 13;
                        color: #CBD5E1;
                    }

                    Row {
                        gap: 8dp;
                        Button {
                            text: "📋 Copy Text to Clipboard";
                            background: #0284C7;
                            foreground: #FFFFFF;
                            border_radius: 8dp;
                            padding: 8dp;
                            on_tap => {
                                status_message = "OCR Text copied to clipboard!";
                            }
                        }
                    }
                }

                // Device Capabilities & Permissions Card
                Column {
                    width: 100%;
                    background: #1E293B;
                    border_radius: 12dp;
                    padding: 12dp;
                    gap: 8dp;

                    Text { text: "Hardware & Permissions Telemetry"; font_size: 15; font_weight: 600; color: #FFFFFF; }

                    Row {
                        gap: 8dp;
                        Badge { label: camera_perm_badge; background: #059669; color: #FFFFFF; }
                        Badge { label: battery_status; background: #334155; color: #FFFFFF; }
                        Badge { label: storage_status; background: #334155; color: #94A3B8; }
                    }

                    Button {
                        text: "Request Camera & Storage Permissions";
                        background: #334155;
                        foreground: #FFFFFF;
                        border_radius: 8dp;
                        padding: 8dp;
                        on_tap => {
                            on_request_permissions();
                        }
                    }
                }
            }

            // =========================================================================
            // VIEW 5: PDF TOOLS & EXPORT
            // =========================================================================
            if active_tab == 5 : Column {
                flex_grow: 1.0;
                width: 100%;
                gap: 12dp;

                Row {
                    width: 100%;
                    justify: SpaceBetween;
                    align: Center;

                    Button {
                        text: "← Back";
                        background: #1E293B;
                        foreground: #FFFFFF;
                        border_radius: 8dp;
                        padding: 6dp;
                        on_tap => {
                            active_tab = 0;
                        }
                    }

                    Text {
                        text: "PDF Tools Studio";
                        font_size: 18;
                        font_weight: 700;
                        color: #FFFFFF;
                    }

                    Button {
                        text: "Done";
                        background: #10B981;
                        foreground: #FFFFFF;
                        border_radius: 8dp;
                        padding: 6dp;
                        on_tap => {
                            active_tab = 0;
                        }
                    }
                }

                Column {
                    width: 100%;
                    background: #1E293B;
                    border_radius: 12dp;
                    padding: 12dp;
                    gap: 10dp;

                    Text { text: "Export & PDF Conversion Options"; font_size: 15; font_weight: 600; color: #FFFFFF; }

                    Button {
                        text: "📄 Export as High-Quality Searchable PDF (A4)";
                        background: #0284C7;
                        foreground: #FFFFFF;
                        border_radius: 8dp;
                        padding: 10dp;
                        on_tap => {
                            on_share_doc();
                        }
                    }

                    Button {
                        text: "🗜️ Compress PDF to Under 1 MB";
                        background: #334155;
                        foreground: #E2E8F0;
                        border_radius: 8dp;
                        padding: 10dp;
                        on_tap => {
                            status_message = "Compressed PDF ready!";
                        }
                    }

                    Button {
                        text: "🔒 Add Password Protection & Security";
                        background: #334155;
                        foreground: #E2E8F0;
                        border_radius: 8dp;
                        padding: 10dp;
                        on_tap => {
                            status_message = "PDF Security settings applied";
                        }
                    }
                }
            }

            // =========================================================================
            // VIEW 3: HTML & TAILWIND SYNTAX SCREEN (COMPILED DIRECTLY INTO RUST)
            // =========================================================================
            if active_tab == 3 : Column {
                flex_grow: 1.0;
                width: 100%;
                gap: 12dp;

                // Back Row & Engine Badge
                Row {
                    width: 100%;
                    justify: SpaceBetween;
                    align: Center;

                    Button {
                        text: "← Back";
                        background: #1E293B;
                        foreground: #FFFFFF;
                        border_radius: 8dp;
                        padding: 6dp;
                        on_tap => {
                            active_tab = 0;
                        }
                    }

                    Text {
                        text: "HTML+Tailwind (AOT Pure Rust)";
                        font_size: 15;
                        font_weight: 700;
                        color: #00BCD4;
                    }

                    Badge {
                        label: "0ms Webview • 120 FPS";
                        background: #064E3B;
                        color: #34D399;
                    }
                }

                // HTML Semantic Tags compiled to pure native Rust GPU nodes
                header {
                    class: "flex flex-row justify-between items-center w-full py-1";
                    button {
                        class: "w-10 h-10 rounded-full bg-[#0E2938]";
                        Icon { svg: "user"; }
                    }
                    div {
                        class: "flex flex-row items-center gap-2";
                        span {
                            class: "text-xl font-bold text-[#00BCD4]";
                            text: "ScanApp (HTML AOT)";
                        }
                    }
                    div {
                        class: "flex flex-row items-center gap-3";
                        button {
                            class: "w-8 h-8 rounded-full";
                            on_tap => { on_theme_toggle(); }
                            Icon { svg: "sun"; }
                        }
                        button {
                            class: "w-8 h-8 rounded-full";
                            Icon { svg: "search"; }
                        }
                    }
                }

                section {
                    class: "flex flex-row justify-between items-center w-full py-2";
                    button {
                        class: "flex flex-col items-center gap-2";
                        on_tap => { on_capture_photo(); }
                        div {
                            class: "w-14 h-14 rounded-full bg-[#0E3B43] shadow-md";
                            Icon { svg: "camera"; }
                        }
                        span {
                            class: "text-xs font-medium text-slate-200";
                            text: "Smart Scan";
                        }
                    }
                    button {
                        class: "flex flex-col items-center gap-2";
                        on_tap => { on_import_gallery(); }
                        div {
                            class: "w-14 h-14 rounded-full bg-[#1E3A68] shadow-md";
                            Icon { svg: "image"; }
                        }
                        span {
                            class: "text-xs font-medium text-slate-200";
                            text: "Import Photos";
                        }
                    }
                    button {
                        class: "flex flex-col items-center gap-2";
                        div {
                            class: "w-14 h-14 rounded-full bg-[#452A14] shadow-md";
                            Icon { svg: "upload"; }
                        }
                        span {
                            class: "text-xs font-medium text-slate-200";
                            text: "Import Files";
                        }
                    }
                    button {
                        class: "flex flex-col items-center gap-2";
                        div {
                            class: "w-14 h-14 rounded-full bg-[#0E2F38] shadow-md";
                            Icon { svg: "badge_id"; }
                        }
                        span {
                            class: "text-xs font-medium text-slate-200";
                            text: "ID Card";
                        }
                    }
                }

                // Recent Docs List
                section {
                    class: "flex flex-col w-full gap-3";
                    div {
                        class: "flex flex-row justify-between items-center w-full";
                        span {
                            class: "text-lg font-bold text-white";
                            text: "Recent Scans (Compiled HTML)";
                        }
                    }
                    div {
                        class: "flex flex-row items-center justify-between w-full p-3 bg-zinc-900 rounded-xl";
                        div {
                            class: "flex flex-row items-center gap-3";
                            div {
                                class: "w-12 h-14 bg-slate-800 rounded-md";
                            }
                            div {
                                class: "flex flex-col gap-1";
                                span {
                                    class: "text-sm font-semibold text-white";
                                    text: "Contract_Agreement_v2.pdf";
                                }
                                span {
                                    class: "text-xs text-slate-400";
                                    text: "09/11/26 21:46 • 3 Pages • AOT Pure Rust";
                                }
                            }
                        }
                    }
                }
            }

            // =========================================================================
            // VIEW 4: TAURI 2.0 HYBRID WEBVIEW MODE (scanapp.html)
            // =========================================================================
            if active_tab == 4 : Column {
                flex_grow: 1.0;
                width: 100%;
                gap: 12dp;

                Row {
                    width: 100%;
                    justify: SpaceBetween;
                    align: Center;

                    Button {
                        text: "← Back";
                        background: #1E293B;
                        foreground: #FFFFFF;
                        border_radius: 8dp;
                        padding: 6dp;
                        on_tap => {
                            active_tab = 0;
                        }
                    }

                    Text {
                        text: "Tauri 2.0 Hybrid Mode";
                        font_size: 16;
                        font_weight: 700;
                        color: #00BCD4;
                    }

                    Badge {
                        label: "Tauri IPC Active";
                        background: #1E3A8A;
                        color: #93C5FD;
                    }
                }

                HtmlView {
                    src: "ui/scanapp.html";
                }
            }
        }
    }
}
