{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "CraftUI",
  "scopeName": "source.cui",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#colors" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#builtin-widgets" },
    { "include": "#constants" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#property-bindings" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.cui",
          "match": "//.*$"
        },
        {
          "name": "comment.block.cui",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.cui",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.cui",
              "match": "\\\\([\"\\\\/bfnrt]|u[0-9a-fA-F]{4})"
            }
          ]
        },
        {
          "name": "string.quoted.single.cui",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.cui",
              "match": "\\\\(['\\\\/bfnrt]|u[0-9a-fA-F]{4})"
            }
          ]
        }
      ]
    },
    "colors": {
      "patterns": [
        {
          "name": "constant.other.color.hex.cui",
          "match": "#([0-9a-fA-F]{8}|[0-9a-fA-F]{6}|[0-9a-fA-F]{4}|[0-9a-fA-F]{3})\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.cui",
          "match": "\\b(export|import|from|component|struct|enum|property|in-out|in|out|callback|if|else|for|animate|easing)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.primitive.cui",
          "match": "\\b(int|uint|usize|float|bool|string|color|TextureHandle|ThemeMode)\\b"
        }
      ]
    },
    "builtin-widgets": {
      "patterns": [
        {
          "name": "entity.name.class.widget.cui",
          "match": "\\b(SafeArea|SegmentedControl|Accordion|DataTable|Spinner|Badge|SplitPane|ToastHost|Modal|BottomSheet|PlatformView|View|Container|Column|Row|Grid|Stack|Spacer|Divider|Text|Button|ImageView|Image|Icon|Canvas|ScrollView|VirtualList|VirtualGrid|TextInput|TextArea|Checkbox|Switch|Slider|Tabs|TabBar|Select|Dropdown|RadioGroup|PopupMenu|Tooltip|ProgressIndicator)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.cui",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "support.class.builtin.cui",
          "match": "\\b(Theme|Easing|SafeArea|Pointer|Center|Start|End|Stretch|Baseline|SpaceBetween|SpaceAround|SpaceEvenly|Horizontal|Vertical|Contain|Cover|Fill|ScaleDown)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.dimension.cui",
          "match": "\\b-?\\d+(\\.\\d+)?(dp|px|pt|%|ms|s|deg|rad)\\b"
        },
        {
          "name": "constant.numeric.float.cui",
          "match": "\\b-?\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.cui",
          "match": "\\b-?\\d+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.binding.two-way.cui",
          "match": "<=>"
        },
        {
          "name": "keyword.operator.binding.handler.cui",
          "match": "=>"
        },
        {
          "name": "keyword.operator.logical.cui",
          "match": "(&&|\\|\\||!)"
        },
        {
          "name": "keyword.operator.comparison.cui",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.arithmetic.cui",
          "match": "(\\+|-|\\*|/|%)"
        }
      ]
    },
    "property-bindings": {
      "patterns": [
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(:)",
          "captures": {
            "1": { "name": "variable.other.property.cui" },
            "2": { "name": "punctuation.separator.key-value.cui" }
          }
        }
      ]
    }
  }
}
