                Row { width: 100%; height: 2dp; background: #BFDBFE; }
                Row { width: 85%; height: 2.5dp; background: #334155; border_radius: 1dp; }
                Row { width: 100%; height: 2dp; background: #BFDBFE; }
                Row { width: 60%; height: 2.5dp; background: #334155; border_radius: 1dp; }
            }

            Row {
                width: 100%;
                justify: End;
                Badge { label: "✓"; background: #00897B; color: #FFFFFF; }
